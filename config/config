# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=true

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
gki-android12-5.10=
# K60 Pro：上游 2026-11-06 成功构建所用提交
gki-android13-5.15=d5df1d937361530787fafa920dea3a9b6dc8ebef
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
# 留空：由工作流按 enable_susfs 选择分支；关闭 SUSFS 时走 Nova main 最新 tag（v3.0.0）
# 注意：4bec532d 是 Nova builtin 分支的头，不是 main，填它会走 builtin
sukisu=
